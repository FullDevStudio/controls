@namespace Shiny.Blazor.Controls.Media
@implements IAsyncDisposable

@*
    The mask sits on the wrapper rather than the <video>: a few WebKit builds drop a mask applied straight
    to a video element while it is hardware-decoding, and the wrapper costs nothing.
*@
<div class="shiny-video-text @CssClass"
     style="@ContainerStyle"
     role="img"
     aria-label="@Text">
    <video @ref="videoEl"
           class="shiny-video-text-video"
           src="@Source"
           autoplay
           loop
           muted="@IsMuted"
           playsinline
           preload="@Preload"
           disablepictureinpicture
           disableremoteplayback
           aria-hidden="true"></video>
</div>
