<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Features.Camera"
             x:Class="Sample.Features.Camera.DocumentSessionPage"
             Title="Scanned Documents"
             AutomationId="DocumentSessionPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Clear" Clicked="OnClearClicked" AutomationId="ClearDocumentsButton" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Documents}"
                    Margin="12">
        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center">
                <Label Text="No documents scanned yet"
                       AutomationId="NoDocumentsLabel"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Text="Open the Camera, enable a document detector (Invoice, Receipt, Business Card, License, Credit Card, Passport) and point it at a document. Captures collect here for this app session."
                       FontSize="13"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:CapturedDocument">
                <Border Margin="0,6"
                        Padding="14,12"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F5F3FF, Dark=#1C1C1E}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Kind}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}" />
                            <Label Grid.Column="1"
                                   Text="{Binding CapturedAt, StringFormat='{0:HH:mm:ss}'}"
                                   FontSize="12"
                                   TextColor="Gray"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                        <Label Text="{Binding Summary}"
                               FontSize="14" />
                        <Label Text="{Binding Detail}"
                               FontSize="12"
                               TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
