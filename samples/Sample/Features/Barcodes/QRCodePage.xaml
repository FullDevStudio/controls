<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bc="http://shiny.net/maui/barcodes"
             xmlns:local="clr-namespace:Sample.Features.Barcodes"
             x:Class="Sample.Features.Barcodes.QRCodePage"
             x:DataType="local:QRCodeViewModel"
             Title="QR Code"
             AutomationId="QRCodePage">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <Label Text="Content"
                   FontAttributes="Bold"
                   FontSize="14" />
            <Entry AutomationId="QRValueEntry"
                   Text="{Binding Value}"
                   Placeholder="Type any text or URL" />

            <Label Text="Error Correction"
                   FontAttributes="Bold"
                   FontSize="14" />
            <Picker AutomationId="QRErrorPicker"
                    ItemsSource="{Binding ErrorCorrectionLevels}"
                    SelectedItem="{Binding ErrorCorrection}" />

            <Label Text="Size"
                   FontAttributes="Bold"
                   FontSize="14" />
            <Slider AutomationId="QRSizeSlider" Minimum="150" Maximum="500" Value="{Binding Size}" />
            <Label AutomationId="QRSizeLabel" Text="{Binding Size, StringFormat='{0:F0} px'}" />

            <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    StrokeThickness="1"
                    Padding="12"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <bc:QRCodeView AutomationId="QRCodeView"
                               Value="{Binding Value}"
                               Size="{Binding Size}"
                               ErrorCorrection="{Binding ErrorCorrection}"
                               WidthRequest="{Binding Size}"
                               HeightRequest="{Binding Size}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
