<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:local="clr-namespace:Sample.Features.CoverFlow"
             x:Class="Sample.Features.CoverFlow.CoverFlowPage"
             x:DataType="local:CoverFlowViewModel"
             Title="Cover Flow"
             AutomationId="CoverFlowPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Cover Flow" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Status}"
                   AutomationId="CoverFlowStatus"
                   FontSize="14"
                   TextColor="Gray" />

            <shiny:CoverFlowView x:Name="Flow"
                                 AutomationId="CoverFlow"
                                 ItemsSource="{Binding Albums}"
                                 CurrentPosition="{Binding CurrentPosition}"
                                 Loop="{Binding Loop}"
                                 ShowReflection="{Binding ShowReflection}"
                                 SideAngle="{Binding SideAngle}"
                                 SideScale="{Binding SideScale}"
                                 ItemSelectedCommand="{Binding SelectCommand}"
                                 ItemWidth="180"
                                 ItemHeight="180"
                                 CenterSpacing="120"
                                 ItemSpacing="44">
                <shiny:CoverFlowView.ItemTemplate>
                    <DataTemplate x:DataType="local:Album">
                        <Border StrokeThickness="0" BackgroundColor="{Binding Color}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <Grid Padding="14" RowDefinitions="*,Auto,Auto">
                                <Label Text="♪" FontSize="64" TextColor="#40FFFFFF"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Label Grid.Row="1" Text="{Binding Title}" TextColor="White"
                                       FontAttributes="Bold" FontSize="16" />
                                <Label Grid.Row="2" Text="{Binding Artist}" TextColor="#DDFFFFFF" FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </shiny:CoverFlowView.ItemTemplate>
                <shiny:CoverFlowView.CaptionTemplate>
                    <DataTemplate x:DataType="local:Album">
                        <VerticalStackLayout Spacing="2" Padding="0,4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="18"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Artist, StringFormat='{0}'}" FontSize="13" TextColor="Gray"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Year}" FontSize="12" TextColor="Gray"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </shiny:CoverFlowView.CaptionTemplate>
            </shiny:CoverFlowView>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="‹ Previous" Clicked="OnPrevious" AutomationId="CoverFlowPrevious" />
                <Label Text="{Binding PositionLabel}" AutomationId="CoverFlowPosition"
                       VerticalTextAlignment="Center" FontAttributes="Bold" />
                <Button Text="Next ›" Clicked="OnNext" AutomationId="CoverFlowNext" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                <Label Text="Loop" VerticalTextAlignment="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding Loop}" AutomationId="CoverFlowLoop" />
                <Label Grid.Row="1" Text="Reflection" VerticalTextAlignment="Center" />
                <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding ShowReflection}" AutomationId="CoverFlowReflection" />
            </Grid>

            <Label Text="{Binding SideAngle, StringFormat='Side angle: {0:F0}°'}" />
            <Slider Minimum="0" Maximum="80" Value="{Binding SideAngle}" AutomationId="CoverFlowAngle" />

            <Label Text="{Binding SideScale, StringFormat='Side scale: {0:F2}'}" />
            <Slider Minimum="0.5" Maximum="1" Value="{Binding SideScale}" AutomationId="CoverFlowScale" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
