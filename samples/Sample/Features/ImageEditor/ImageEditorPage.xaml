<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:local="clr-namespace:Sample.Features.ImageEditor"
             x:Class="Sample.Features.ImageEditor.ImageEditorPage"
             x:DataType="local:ImageEditorViewModel"
             Title="Image Editor">

    <shiny:ImageEditor Source="{Binding ImageSource}"
                       AutomationId="PhotoEditor"
                       CurrentToolMode="{Binding CurrentToolMode}"
                       CanUndo="{Binding CanUndo}"
                       CanRedo="{Binding CanRedo}"
                       DrawStrokeColor="{Binding DrawColor}"
                       DrawStrokeWidth="{Binding DrawStrokeWidth}"
                       AvailableFonts="{Binding AvailableFonts}"
                       TextFontFamily="{Binding TextFontFamily}"
                       AvailableFontSizes="{Binding AvailableFontSizes}"
                       TextFontSize="{Binding TextFontSize}"
                       SaveCommand="{Binding SaveCommand}"
                       AllowCrop="True"
                       AllowRotate="True"
                       AllowDraw="True"
                       AllowLine="True"
                       AllowArrow="True"
                       AllowRectangle="True"
                       AllowEllipse="True"
                       AllowCircle="True"
                       ShapeFillColor="{Binding ShapeFillColor}"
                       ShowShapeFillPicker="True"
                       AllowTextAnnotation="True"
                       AllowFontSelection="True"
                       AllowFontSizeSelection="True"
                       AllowZoom="True"
                       ZoomLevel="{Binding ZoomLevel}"
                       MaxZoom="8"
                       ShowZoomControls="True"
                       ShowToolLabels="True"
                       ShowStrokeWidthPicker="True" />

</ContentPage>
