<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:local="clr-namespace:Sample.Features.Ribbon"
             x:Class="Sample.Features.Ribbon.RibbonPage"
             x:DataType="local:RibbonViewModel"
             Title="Ribbon"
             AutomationId="RibbonPage">

    <!--
        The icons here are FontImageSource glyphs so the sample needs no image assets. A real app hands
        Icon a PNG or SVG from its resources, or uses IconTemplate to draw one — the Font group below
        shows that form.
    -->
    <Grid RowDefinitions="Auto,Auto,*">

        <shiny:Ribbon x:Name="Bar"
                      Grid.Row="0"
                      ApplicationButtonText="File"
                      ApplicationButtonCommand="{Binding OpenFileMenu}"
                      DisplayMode="{Binding DisplayMode}"
                      AllowGroupCollapse="{Binding AllowGroupCollapse}"
                      AutomationId="SampleRibbon">

            <shiny:Ribbon.QuickAccessItems>
                <shiny:RibbonButton Text="Save" Size="Small" Tooltip="Save"
                                    Icon="{local:Glyph &#x1F4BE;}"
                                    Command="{Binding RunCommand}" CommandParameter="Save" />
                <shiny:RibbonButton Text="Undo" Size="Small" Tooltip="Undo"
                                    Icon="{local:Glyph &#x21B6;}"
                                    Command="{Binding RunCommand}" CommandParameter="Undo" />
                <shiny:RibbonButton Text="Redo" Size="Small" Tooltip="Redo"
                                    Icon="{local:Glyph &#x21B7;}"
                                    Command="{Binding RunCommand}" CommandParameter="Redo" />
            </shiny:Ribbon.QuickAccessItems>

            <shiny:RibbonTab Title="Home" Key="home" AutomationId="RibbonTabHome">

                <!-- A split button: pasting plain is overwhelmingly the common case, so it keeps the
                     face and the variants go behind the chevron. -->
                <shiny:RibbonGroup Title="Clipboard" Priority="30">
                    <shiny:RibbonSplitButton Text="Paste"
                                             Icon="{local:Glyph &#x1F4CB;}"
                                             Command="{Binding RunCommand}" CommandParameter="Paste">
                        <shiny:RibbonMenuEntry Text="Keep source formatting"
                                               Command="{Binding RunCommand}" CommandParameter="Paste (formatted)" />
                        <shiny:RibbonMenuEntry Text="Text only"
                                               Command="{Binding RunCommand}" CommandParameter="Paste (text)" />
                        <shiny:RibbonMenuEntry IsSeparator="True" />
                        <shiny:RibbonMenuEntry Text="Paste special…"
                                               Command="{Binding RunCommand}" CommandParameter="Paste special" />
                    </shiny:RibbonSplitButton>

                    <shiny:RibbonButton Text="Cut" Size="Small" Icon="{local:Glyph &#x2702;}"
                                        Command="{Binding RunCommand}" CommandParameter="Cut" AutomationId="RibbonCut" />
                    <shiny:RibbonButton Text="Copy" Size="Small" Icon="{local:Glyph &#x29C9;}"
                                        Command="{Binding RunCommand}" CommandParameter="Copy" />
                    <shiny:RibbonButton Text="Format painter" Size="Small" Icon="{local:Glyph &#x1F58C;}"
                                        Command="{Binding RunCommand}" CommandParameter="Format painter" />
                </shiny:RibbonGroup>

                <!-- Three small toggles fill one column, then the size picker takes the next: nothing
                     here declares a column, the sizes do. -->
                <shiny:RibbonGroup Title="Font" Priority="40"
                                   ShowDialogLauncher="True"
                                   DialogLauncherCommand="{Binding OpenFontDialog}">
                    <shiny:RibbonToggleButton Text="Bold" Size="Small" IsChecked="{Binding Bold}"
                                              Icon="{local:Glyph B}" AutomationId="RibbonBold" />
                    <shiny:RibbonToggleButton Text="Italic" Size="Small" IsChecked="{Binding Italic}"
                                              Icon="{local:Glyph I}" AutomationId="RibbonItalic" />
                    <shiny:RibbonToggleButton Text="Underline" Size="Small" IsChecked="{Binding Underline}"
                                              Icon="{local:Glyph U}" />

                    <shiny:RibbonSeparator />

                    <!-- IconTemplate rather than Icon: the swatch is drawn, not loaded. -->
                    <shiny:RibbonMenuButton Text="Text colour">
                        <shiny:RibbonMenuButton.IconTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#C2410C" StrokeThickness="0" />
                            </DataTemplate>
                        </shiny:RibbonMenuButton.IconTemplate>
                        <shiny:RibbonMenuEntry Text="Automatic" IsChecked="True"
                                               Command="{Binding RunCommand}" CommandParameter="Colour: automatic" />
                        <shiny:RibbonMenuEntry Text="Standard colours">
                            <shiny:RibbonMenuEntry Text="Red"
                                                   Command="{Binding RunCommand}" CommandParameter="Colour: red" />
                            <shiny:RibbonMenuEntry Text="Blue"
                                                   Command="{Binding RunCommand}" CommandParameter="Colour: blue" />
                        </shiny:RibbonMenuEntry>
                    </shiny:RibbonMenuButton>

                    <!-- Any view at all can sit in a group. -->
                    <shiny:RibbonContentItem Size="Small">
                        <shiny:FontSizePicker SelectedFontSize="{Binding FontSize}" WidthRequest="86" />
                    </shiny:RibbonContentItem>
                </shiny:RibbonGroup>

                <shiny:RibbonGroup Title="Paragraph" Priority="20">
                    <shiny:RibbonToggleButton Text="Left" Size="Small" Icon="{local:Glyph &#x2261;}"
                                              IsChecked="{Binding AlignLeft}" />
                    <shiny:RibbonToggleButton Text="Centre" Size="Small" Icon="{local:Glyph &#x2263;}"
                                              IsChecked="{Binding AlignCenter}" AutomationId="RibbonAlignCenter" />
                    <shiny:RibbonToggleButton Text="Right" Size="Small" Icon="{local:Glyph &#x2261;}"
                                              IsChecked="{Binding AlignRight}" />
                    <shiny:RibbonButton Text="Bullets" Icon="{local:Glyph &#x2022;}"
                                        Command="{Binding RunCommand}" CommandParameter="Bullets" />
                </shiny:RibbonGroup>

                <!-- The lowest priority, so this is the first group to fold away when the window narrows. -->
                <shiny:RibbonGroup Title="Editing" Priority="0" CollapsedIcon="{local:Glyph &#x1F50D;}">
                    <shiny:RibbonMenuButton Text="Find" Icon="{local:Glyph &#x1F50D;}">
                        <shiny:RibbonMenuEntry Text="Find…"
                                               Command="{Binding RunCommand}" CommandParameter="Find" />
                        <shiny:RibbonMenuEntry Text="Replace…"
                                               Command="{Binding RunCommand}" CommandParameter="Replace" />
                        <shiny:RibbonMenuEntry IsSeparator="True" />
                        <shiny:RibbonMenuEntry Text="Go to…"
                                               Command="{Binding RunCommand}" CommandParameter="Go to" />
                    </shiny:RibbonMenuButton>
                    <shiny:RibbonButton Text="Select all" Size="Small" Icon="{local:Glyph &#x2611;}"
                                        Command="{Binding RunCommand}" CommandParameter="Select all" />
                </shiny:RibbonGroup>
            </shiny:RibbonTab>

            <shiny:RibbonTab Title="Insert" Key="insert" AutomationId="RibbonTabInsert">
                <shiny:RibbonGroup Title="Tables" Priority="10">
                    <shiny:RibbonButton Text="Table" Icon="{local:Glyph &#x25A6;}"
                                        Command="{Binding RunCommand}" CommandParameter="Insert table" />
                </shiny:RibbonGroup>

                <shiny:RibbonGroup Title="Illustrations" Priority="10">
                    <shiny:RibbonButton Text="Picture" Icon="{local:Glyph &#x1F5BC;}"
                                        Command="{Binding InsertPicture}" AutomationId="RibbonInsertPicture" />
                    <shiny:RibbonButton Text="Shapes" Icon="{local:Glyph &#x25B3;}"
                                        Command="{Binding RunCommand}" CommandParameter="Insert shape" />
                    <shiny:RibbonButton Text="Chart" Icon="{local:Glyph &#x1F4CA;}"
                                        Command="{Binding RunCommand}" CommandParameter="Insert chart" />
                </shiny:RibbonGroup>

                <shiny:RibbonGroup Title="Links" Priority="0">
                    <shiny:RibbonButton Text="Link" Size="Small" Icon="{local:Glyph &#x1F517;}"
                                        Command="{Binding RunCommand}" CommandParameter="Insert link" />
                    <shiny:RibbonButton Text="Bookmark" Size="Small" Icon="{local:Glyph &#x1F516;}"
                                        Command="{Binding RunCommand}" CommandParameter="Bookmark" />
                </shiny:RibbonGroup>
            </shiny:RibbonTab>

            <shiny:RibbonTab Title="View" Key="view">
                <shiny:RibbonGroup Title="Show" Priority="0">
                    <shiny:RibbonToggleButton Text="Ruler" Size="Small" IsChecked="{Binding ShowRuler}"
                                              Icon="{local:Glyph &#x1F4CF;}" />
                    <shiny:RibbonToggleButton Text="Gridlines" Size="Small" IsChecked="{Binding ShowGridlines}"
                                              Icon="{local:Glyph &#x25A6;}" />
                </shiny:RibbonGroup>
            </shiny:RibbonTab>

            <!--
                A contextual tab. Nothing special declares it: setting ContextTitle captions the band and
                binding IsVisible to "is a picture selected" is what makes it come and go. The ribbon
                moves onto it when it appears and off it again when it does not.
            -->
            <shiny:RibbonTab Title="Format" Key="picture"
                             AutomationId="RibbonTabPicture"
                             ContextTitle="Picture Tools"
                             IsVisible="{Binding PictureSelected}">
                <shiny:RibbonGroup Title="Adjust" Priority="0" CanCollapse="False">
                    <shiny:RibbonButton Text="Crop" Icon="{local:Glyph &#x2702;}"
                                        Command="{Binding RunCommand}" CommandParameter="Crop" />
                    <shiny:RibbonButton Text="Reset" Size="Small" Icon="{local:Glyph &#x21BA;}"
                                        Command="{Binding RunCommand}" CommandParameter="Reset picture" />
                </shiny:RibbonGroup>
            </shiny:RibbonTab>
        </shiny:Ribbon>

        <VerticalStackLayout Grid.Row="1" Padding="16,12" Spacing="8">
            <Label Text="Narrow the window and the lowest-priority groups fold into buttons. Double-tap the showing tab to collapse the bar; a command run from a collapsed bar puts it away again."
                   FontSize="12" TextColor="Gray" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="Expanded" FontSize="12" Command="{Binding SetModeCommand}" CommandParameter="Expanded" AutomationId="RibbonModeExpanded" />
                <Button Text="Simplified" FontSize="12" Command="{Binding SetModeCommand}" CommandParameter="Simplified" AutomationId="RibbonModeSimplified" />
                <Button Text="Collapsed" FontSize="12" Command="{Binding SetModeCommand}" CommandParameter="Collapsed" AutomationId="RibbonModeCollapsed" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="4">
                    <CheckBox IsChecked="{Binding PictureSelected}" AutomationId="RibbonPictureCheck" />
                    <Label Text="Picture selected (contextual tab)" VerticalOptions="Center" FontSize="12" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="4">
                    <CheckBox IsChecked="{Binding AllowGroupCollapse}" AutomationId="RibbonGroupCollapseCheck" />
                    <Label Text="Let groups collapse" VerticalOptions="Center" FontSize="12" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="2" Padding="16,0,16,16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Log" FontAttributes="Bold" FontSize="13" />
                <Label Text="{Binding Log}" FontSize="12" TextColor="Gray" AutomationId="RibbonLog" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
