<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:local="clr-namespace:Sample.Features.ParallaxCollectionView"
             x:Class="Sample.Features.ParallaxCollectionView.ParallaxCollectionViewPage"
             x:DataType="local:ParallaxCollectionViewModel"
             Title="Parallax Collection"
             AutomationId="ParallaxCollectionViewPage">

    <Grid RowDefinitions="Auto,*">

        <!-- Controls bar -->
        <VerticalStackLayout Grid.Row="0" Padding="20,12,20,8" Spacing="6"
                             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">
            <Label Text="{Binding StatusMessage}"
                   AutomationId="ParallaxStatusLabel"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Factor" Command="{Binding CycleFactorCommand}" AutomationId="ParallaxFactorButton" />
                <Button Text="Toggle Collapse" Command="{Binding ToggleCollapseCommand}" AutomationId="ParallaxCollapseButton" />
                <Button Text="Toggle Fade" Command="{Binding ToggleFadeCommand}" AutomationId="ParallaxFadeButton" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Parallax collection -->
        <shiny:ParallaxCollectionView Grid.Row="1"
                                      AutomationId="ParallaxList"
                                      ItemsSource="{Binding Items}"
                                      HeaderHeight="260"
                                      MinHeaderHeight="96"
                                      ParallaxFactor="{Binding ParallaxFactor}"
                                      CollapseToSticky="{Binding CollapseToSticky}"
                                      FadeHeaderOnScroll="{Binding FadeHeader}"
                                      ItemSelectedCommand="{Binding OnItemSelectedCommand}"
                                      SelectionMode="Single">

            <shiny:ParallaxCollectionView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0.0" />
                                <GradientStop Color="#2563EB" Offset="0.5" />
                                <GradientStop Color="#0EA5E9" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <!-- Decorative circles -->
                        <BoxView CornerRadius="80"
                                 WidthRequest="160" HeightRequest="160"
                                 Color="#FFFFFF" Opacity="0.08"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,-30,-40,0" />
                        <BoxView CornerRadius="60"
                                 WidthRequest="120" HeightRequest="120"
                                 Color="#FFFFFF" Opacity="0.05"
                                 HorizontalOptions="Start" VerticalOptions="End"
                                 Margin="-30,0,0,-30" />

                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="6"
                                             Padding="24">
                            <Label Text="🌎"
                                   FontSize="48"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Destinations"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.4" />
                                </Label.Shadow>
                            </Label>
                            <Label Text="Twenty places worth the trip"
                                   FontSize="13"
                                   TextColor="#E0E7FF"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </shiny:ParallaxCollectionView.HeaderTemplate>

            <shiny:ParallaxCollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ParallaxItem">
                    <Border StrokeThickness="0"
                            Margin="16,6"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.08" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="48,*" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding Color}"
                                    WidthRequest="48"
                                    HeightRequest="48">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Emoji}"
                                       FontSize="24"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                <Label Text="{Binding Subtitle}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </shiny:ParallaxCollectionView.ItemTemplate>
        </shiny:ParallaxCollectionView>
    </Grid>
</ContentPage>
