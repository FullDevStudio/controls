<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             x:Class="Sample.Features.Flyout.FlyoutDrawerPage"
             Title="Flyout Drawer"
             shiny:ShinyFlyout.ScrimOpacity="0.55">

    <!--
        The declare-once form. The same attached properties go on a Shell (with
        FlyoutBehavior="Disabled") or a NavigationPage, where every page it shows gets its own panel
        built from this template and the open/closed state carries across navigation. Declared on one
        page here so the sample gallery does not grow a drawer on every screen.

        The FlyoutView options (PushMode, ScrimColor, ScrimOpacity, IsAnimationEnabled) are attached
        properties on the same host - ScrimOpacity above is copied onto every view it installs.
    -->
    <shiny:ShinyFlyout.StartTemplate>
        <DataTemplate>
            <shiny:FlyoutPanel AutomationId="DrawerPanel"
                               State="Hidden"
                               CollapsedState="Hidden"
                               Presentation="Overlay"
                               ExpandedWidth="280"
                               CornerRadius="0">
                <shiny:FlyoutPanel.HeaderContent>
                    <Label Text="Menu" FontSize="18" FontAttributes="Bold" Padding="20,18" />
                </shiny:FlyoutPanel.HeaderContent>

                <VerticalStackLayout Padding="8,4" Spacing="2">
                    <Label Text="Home" Padding="16,12" />
                    <Label Text="Projects" Padding="16,12" />
                    <Label Text="Reports" Padding="16,12" />
                    <Label Text="Settings" Padding="16,12" />
                </VerticalStackLayout>
            </shiny:FlyoutPanel>
        </DataTemplate>
    </shiny:ShinyFlyout.StartTemplate>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Drawer" FontSize="28" FontAttributes="Bold" />
            <Label Text="A classic drawer: hidden until you open it, floating over the content with a scrim, dismissed by tapping outside. Swipe in from the leading edge to drag it open."
                   Opacity="0.75" />

            <Button Text="Open the drawer" Clicked="OnToggle" AutomationId="DrawerToggle" HorizontalOptions="Start" />

            <BoxView HeightRequest="1" Color="#33808080" />

            <Label Text="This page never mentions a FlyoutView. The two attached properties on the page installed one around its content - the same code path a Shell uses to put one drawer on every page it shows. Its darker scrim comes from ShinyFlyout.ScrimOpacity on the page, not from the view."
                   Opacity="0.75" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
