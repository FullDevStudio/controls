<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Features.FileDrop"
             x:Class="Sample.Features.FileDrop.FileDropPage"
             x:DataType="local:FileDropViewModel"
             Title="File Drop"
             AutomationId="FileDropPage">

    <Grid>
        <ScrollView Padding="16">
            <VerticalStackLayout Spacing="20">

                <Label Text="Window-level file drop"
                       FontSize="22"
                       FontAttributes="Bold" />
                <Label Text="Drag files from Finder / Explorer / Files onto any part of this window — including over a WebView. Windows, macOS (AppKit + Mac Catalyst) and Linux/GTK4." />

                <Border IsVisible="{Binding IsNotSupported}"
                        BackgroundColor="#FEF3C7"
                        Stroke="#F59E0B"
                        StrokeThickness="1"
                        Padding="14"
                        StrokeShape="RoundRectangle 10">
                    <Label Text="{Binding UnsupportedMessage}" TextColor="#78350F" AutomationId="FileDropUnsupported" />
                </Border>

                <Border IsVisible="{Binding IsSupported}"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                        StrokeThickness="1"
                        Padding="14"
                        StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Status" FontAttributes="Bold" FontSize="14" />
                        <Label Text="{Binding DragStatus}" AutomationId="FileDropStatus" />
                        <Label Text="{Binding LastPosition, StringFormat='Last drag position: {0}'}"
                               FontSize="12"
                               Opacity="0.7" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsSupported}" Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Switch IsToggled="{Binding IsEnabled}" AutomationId="FileDropEnabled" />
                        <Label Text="Accept drops" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Switch IsToggled="{Binding ImagesOnly}" AutomationId="FileDropImagesOnly" />
                        <Label Text="Images only (changes the live filter)" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <Button Text="Clear" Command="{Binding ClearCommand}" HorizontalOptions="Start" AutomationId="FileDropClearButton" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding IsSupported}"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                        StrokeThickness="1"
                        Padding="14"
                        StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Dropped files" FontAttributes="Bold" FontSize="14" />
                        <CollectionView ItemsSource="{Binding Files}" HeightRequest="220" AutomationId="FileDropList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="local:DroppedFileRow">
                                    <VerticalStackLayout Padding="0,6" Spacing="2">
                                        <Label Text="{Binding FileName}" FontAttributes="Bold" />
                                        <Label Text="{Binding Path}" FontSize="11" Opacity="0.7" LineBreakMode="MiddleTruncation" />
                                        <Label Text="{Binding Details}" FontSize="11" Opacity="0.7" />
                                        <Label Text="{Binding Preview}" FontSize="11" FontFamily="Courier" IsVisible="{Binding HasPreview}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding IsSupported}"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                        StrokeThickness="1"
                        Padding="14"
                        StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Events" FontAttributes="Bold" FontSize="14" />
                        <CollectionView ItemsSource="{Binding EventLog}" HeightRequest="160">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" FontSize="11" FontFamily="Courier" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- The drop affordance. Nothing draws it for you: the service reports the drag, the app
             decides what that looks like. -->
        <Border IsVisible="{Binding IsDragging}"
                InputTransparent="True"
                BackgroundColor="#CC2563EB"
                Padding="24"
                Margin="24"
                StrokeShape="RoundRectangle 16"
                Stroke="White"
                StrokeThickness="2"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Label Text="{Binding DragStatus}"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold" />
        </Border>
    </Grid>
</ContentPage>
