<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:md="http://shiny.net/maui/markdown"
             xmlns:local="clr-namespace:Sample.Features.Markdown"
             x:Class="Sample.Features.Markdown.MarkdownEditorPage"
             x:DataType="local:MarkdownEditorViewModel"
             Title="Markdown Editor">

    <Grid RowDefinitions="Auto,*">

        <!-- The accessory bar only exists on iOS/Android, so the switch is a no-op on desktop. -->
        <HorizontalStackLayout Padding="12,8" Spacing="10">
            <Switch IsToggled="{Binding ShowToolbarInKeyboard, Mode=TwoWay}"
                    AutomationId="MarkdownKeyboardToolbarSwitch"
                    VerticalOptions="Center" />
            <Label Text="Toolbar on the keyboard"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <md:MarkdownEditor Grid.Row="1"
                           AutomationId="SampleMarkdownEditor"
                           Markdown="{Binding Markdown, Mode=TwoWay}"
                           ShowToolbarInKeyboard="{Binding ShowToolbarInKeyboard}"
                           Placeholder="Start writing markdown..."
                           Padding="8" />
    </Grid>

</ContentPage>
