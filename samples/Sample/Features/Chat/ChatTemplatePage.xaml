<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shiny="http://shiny.net/maui/controls"
    xmlns:local="clr-namespace:Sample.Features.Chat"
    x:Class="Sample.Features.Chat.ChatTemplatePage"
    x:DataType="local:ChatTemplateViewModel"
    Title="Chat Templates">

    <shiny:ChatView AutomationId="TemplateChatView"
                    Provider="{Binding Provider}"
                    SessionId="{Binding SessionId}">
        <!-- ChatView builds its own composer; supply one only to reshape it. -->
        <shiny:ChatView.InputBar>
            <shiny:ChatEntryView PlaceholderText="How can I help you today?"
                                 SendButtonText="↑"
                                 MaxLines="5"
                                 CornerRadius="24">
                <shiny:ChatEntryView.LeftToolbar>
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="10,4"
                            BackgroundColor="#22808080"
                            VerticalOptions="Center">
                        <Label Text="Chat" FontSize="13" />
                    </Border>
                </shiny:ChatEntryView.LeftToolbar>
                <shiny:ChatEntryView.RightToolbar>
                    <Label Text="Model" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Text="🎤" FontSize="16" VerticalOptions="Center" />
                </shiny:ChatEntryView.RightToolbar>
            </shiny:ChatEntryView>
        </shiny:ChatView.InputBar>
        <shiny:ChatView.MessageTemplateSelector>
            <local:ChatMessageTemplateSelector>
                <local:ChatMessageTemplateSelector.TextTemplate>
                    <DataTemplate x:DataType="shiny:ChatMessage">
                        <Label Text="{Binding Body}"
                               FontSize="15"
                               LineBreakMode="WordWrap" />
                    </DataTemplate>
                </local:ChatMessageTemplateSelector.TextTemplate>
                <local:ChatMessageTemplateSelector.ActionTemplate>
                    <DataTemplate x:DataType="shiny:ChatMessage">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Body}"
                                   FontSize="15"
                                   LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="{Binding Metadata[actionText]}"
                                        FontSize="12"
                                        HeightRequest="32"
                                        Padding="12,0"
                                        BackgroundColor="#007AFF"
                                        TextColor="White"
                                        CornerRadius="16"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:ChatTemplateViewModel}}, Path=ActionCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="Dismiss"
                                        FontSize="12"
                                        HeightRequest="32"
                                        Padding="12,0"
                                        BackgroundColor="#E5E5EA"
                                        TextColor="#333"
                                        CornerRadius="16"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:ChatTemplateViewModel}}, Path=DismissCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </local:ChatMessageTemplateSelector.ActionTemplate>
                <local:ChatMessageTemplateSelector.CardTemplate>
                    <DataTemplate x:DataType="shiny:ChatMessage">
                        <Border StrokeThickness="1"
                                Stroke="#E0E0E0"
                                StrokeShape="RoundRectangle 8"
                                Padding="0"
                                BackgroundColor="White">
                            <VerticalStackLayout>
                                <Image Source="{Binding ImageUrl}"
                                       HeightRequest="120"
                                       Aspect="AspectFill" />
                                <VerticalStackLayout Padding="12" Spacing="4">
                                    <Label Text="{Binding Metadata[cardTitle]}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="Black" />
                                    <Label Text="{Binding Body}"
                                           FontSize="12"
                                           TextColor="Gray"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </local:ChatMessageTemplateSelector.CardTemplate>
            </local:ChatMessageTemplateSelector>
        </shiny:ChatView.MessageTemplateSelector>
    </shiny:ChatView>

</ContentPage>
