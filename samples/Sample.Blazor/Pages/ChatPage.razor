@page "/chat"
@using Shiny.Blazor.Controls.Chat
@using Sample.Blazor.Chat
@inject InMemoryChatSessionProvider ChatProvider

<h3>Chat</h3>

<p style="color:gray;font-size:14px;">
    Provider-driven chat. Send a message and a simulated reply arrives after a short typing burst.
    React, edit, delete, and scroll up to page history.
</p>

<div class="demo-fill">
<div class="demo-fill-body" style="border:1px solid var(--shiny-color-outline-variant, #ccc);border-radius:12px;overflow:hidden;">
    @* No bubble colours: both follow the theme now, which is what a chat dropped into a dark app
       should look like. Set them to pin the classic messenger green/white. *@
    <ChatView Provider="ChatProvider"
              SessionId="@InMemoryChatSessionProvider.DemoSessionId"
              PlaceholderText="How can I help you today?" />
</div>
</div>
