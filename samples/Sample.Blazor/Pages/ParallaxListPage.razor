@page "/parallaxlist"

<PageTitle>Parallax List</PageTitle>

<h1>Parallax List</h1>
<p style="margin-bottom:12px;color:#475569;">@status</p>

<section class="demo-section demo-fill">
    <h2>Hero header that translates on scroll</h2>

    <div style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <label>Factor:</label>
        <button @onclick="() => factor = 0.2">0.2</button>
        <button @onclick="() => factor = 0.5">0.5</button>
        <button @onclick="() => factor = 0.8">0.8</button>
        <strong>@factor.ToString("F1")</strong>
        <label style="margin-left:16px;">
            <input type="checkbox" @bind="collapse" /> Collapse to sticky
        </label>
        <label>
            <input type="checkbox" @bind="fade" /> Fade
        </label>
    </div>

    <div class="demo-fill-body" style="border:1px solid var(--shiny-color-outline-variant, #e2e8f0);border-radius:14px;overflow:hidden;background:var(--shiny-color-surface, #fff);">
        <ParallaxList TItem="DestinationItem"
                      Items="@items"
                      HeaderHeight="260"
                      MinHeaderHeight="96"
                      ParallaxFactor="@factor"
                      CollapseToSticky="@collapse"
                      FadeHeaderOnScroll="@fade"
                      ItemSelected="@(item => status = $"Tapped: {item.Title}")"
                      Scrolled="@(e => visibleHeader = e.HeaderVisibleHeight)">
            <HeroTemplate>
                <div style="position:relative;width:100%;height:100%;
                            background:linear-gradient(135deg,#7C3AED 0%,#2563EB 50%,#0EA5E9 100%);
                            color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;
                            text-align:center;padding:24px;overflow:hidden;">
                    <div style="position:absolute;top:-30px;right:-40px;width:160px;height:160px;
                                background:white;opacity:0.08;border-radius:50%;"></div>
                    <div style="position:absolute;bottom:-30px;left:-30px;width:120px;height:120px;
                                background:white;opacity:0.05;border-radius:50%;"></div>
                    <div style="font-size:48px;line-height:1;">🌎</div>
                    <h2 style="margin:8px 0 4px;font-size:28px;font-weight:700;
                               text-shadow:0 2px 6px rgba(0,0,0,0.35);">Destinations</h2>
                    <div style="font-size:13px;color:#E0E7FF;">Twenty places worth the trip</div>
                </div>
            </HeroTemplate>

            <ItemTemplate Context="item">
                <div style="margin:6px 16px;padding:16px;border-radius:14px;background:var(--shiny-color-surface-container-low, white);
                            box-shadow:0 4px 10px rgba(0,0,0,0.06);display:flex;gap:14px;align-items:center;">
                    <div style="width:48px;height:48px;border-radius:12px;background:@item.Color;
                                display:flex;align-items:center;justify-content:center;font-size:24px;">
                        @item.Emoji
                    </div>
                    <div>
                        <div style="font-weight:700;color:#0F172A;font-size:16px;">@item.Title</div>
                        <div style="color:#64748B;font-size:12px;">@item.Subtitle</div>
                    </div>
                </div>
            </ItemTemplate>

            <EmptyTemplate>
                <p>No items.</p>
            </EmptyTemplate>
        </ParallaxList>
    </div>

    <p style="margin-top:8px;color:#64748B;font-size:12px;">
        Visible header height: <strong>@visibleHeader.ToString("F0")px</strong>
    </p>
</section>

@code {
    string status = "Scroll to see the hero translate at half speed";
    double factor = 0.5;
    bool collapse;
    bool fade;
    double visibleHeader = 260;

    record DestinationItem(string Title, string Subtitle, string Emoji, string Color);

    List<DestinationItem> items = new()
    {
        new("Mountain Lake",    "Alpine reflection",          "🏔️", "#2563EB"),
        new("Desert Dunes",     "Golden hour at the dunes",   "🏜️", "#D97706"),
        new("Coral Reef",       "Tropical underwater life",   "🐠", "#0891B2"),
        new("Misty Forest",     "Moss and rain",              "🌲", "#15803D"),
        new("Sunset Cliffs",    "End-of-day pacific coast",   "🌅", "#DC2626"),
        new("Northern Lights",  "Auroras over the fjord",     "✨", "#7C3AED"),
        new("Tokyo Streets",    "Neon, rain, and ramen",      "🏙️", "#DB2777"),
        new("Tuscan Hills",     "Vineyards and stone roads",  "🍇", "#92400E"),
        new("Iceland Glacier",  "Blue ice caves",             "🧊", "#0EA5E9"),
        new("Sahara Stars",     "A sky thick with stars",     "🌌", "#1E1B4B"),
        new("Bali Rice Fields", "Terraces at dawn",           "🌾", "#65A30D"),
        new("Patagonia",        "Wind, granite, and glaciers","🥾", "#0F766E"),
        new("Kyoto Temples",    "Cherry blossoms in bloom",   "🌸", "#EC4899"),
        new("Greek Islands",    "White domes, blue sea",      "⛵", "#2563EB"),
        new("Moroccan Souk",    "Spice, tile, and color",     "🧿", "#B45309"),
        new("Norwegian Fjord",  "Cliffs into deep water",     "🌊", "#1D4ED8"),
        new("Scottish Moors",   "Heather and grey sky",       "🌫️", "#4B5563"),
        new("Big Sur Coast",    "Highway 1 lookouts",         "🚐", "#A16207"),
        new("Swiss Alps",       "Snow on the matterhorn",     "⛰️", "#0F172A"),
        new("Costa Rican Rain", "Cloud forest mornings",      "🦜", "#16A34A"),
    };
}
