@page "/textentry"

<PageTitle>Text Entry</PageTitle>

<h1>Text Entry</h1>

<div class="demo-section">
    <h2>Basic</h2>
    <TextEntry Placeholder="First Name" @bind-Text="firstName" />
    <br />
    <TextEntry Placeholder="Last Name" @bind-Text="lastName" />
    <div class="state">First: <code>@firstName</code> | Last: <code>@lastName</code></div>
</div>

<div class="demo-section">
    <h2>Floating Label (M3 notched outline)</h2>
    <TextEntry Placeholder="Email address" Variant="TextEntryVariant.Floating" @bind-Text="floatingEmail" />
    <br />
    <TextEntry Placeholder="Password" Variant="TextEntryVariant.Floating" IsPassword="true" @bind-Text="floatingPassword" />
    <br />
    <TextEntry Placeholder="Search with a leading icon"
               Variant="TextEntryVariant.Floating"
               @bind-Text="floatingSearch"
               LeftTools="floatingLeftTools"
               RightTools="floatingRightTools" />
</div>

<div class="demo-section">
    <h2>No Autocomplete</h2>
    <TextEntry Placeholder="Serial number"
               @bind-Text="serial"
               IsAutoCompleteEnabled="false"
               HintText="Autofill, autocorrect, prediction and spell check are all off" />
</div>

<div class="demo-section">
    <h2>Addon Tool Style (opt-in)</h2>
    <TextEntry Placeholder="Amount"
               @bind-Text="addonAmount"
               ToolStyle="TextEntryToolStyle.Addon"
               LeftTools="addonLeftTools"
               RightTools="addonRightTools" />
</div>

<div class="demo-section">
    <h2>With Clear Button</h2>
    <TextEntry Placeholder="Search"
               @bind-Text="searchText"
               RightTools="searchTools" />
    <div class="state">Search: <code>@searchText</code></div>
</div>

<div class="demo-section">
    <h2>Password</h2>
    <TextEntry Placeholder="Password"
               IsPassword="true"
               @bind-Text="password"
               RightTools="passwordTools" />
</div>

<div class="demo-section">
    <h2>Character Count</h2>
    <TextEntry Placeholder="Bio (max 100)" @bind-Text="bio" MaxLength="100" ShowCharacterCount="true" />
</div>

<div class="demo-section">
    <h2>Validation</h2>
    <TextEntry Placeholder="Email"
               @bind-Text="email"
               @bind-Text:after="ValidateEmail"
               HasError="@hasEmailError"
               HintText="@emailError"
               RightTools="emailTools" />
</div>

<div class="demo-section">
    <h2>Custom Styling</h2>
    @* Pinning a literal fill means pinning the ink with it: the theme's on-surface goes light in
       dark mode and would vanish into this lavender. *@
    <TextEntry Placeholder="Purple theme"
               @bind-Text="customText"
               FocusedBorderColor="#7C3AED"
               FocusedPlaceholderColor="#7C3AED"
               FocusedBorderThickness="2"
               CornerRadius="16px"
               EntryBackgroundColor="#F5F3FF"
               TextColor="#1E1B4B"
               RightTools="customTools" />
</div>

<div class="demo-section">
    <h2>Read Only</h2>
    <TextEntry Placeholder="Read only"
               Text="This field is read only"
               IsReadOnly="true"
               BorderColor="var(--shiny-color-outline-variant, #E5E7EB)"
               EntryBackgroundColor="var(--shiny-color-surface-container, #F9FAFB)" />
</div>

<div class="demo-section">
    <h2>Hint Text</h2>
    <TextEntry Placeholder="Phone Number"
               @bind-Text="phone"
               HintText="Include country code" />
</div>

<div class="demo-section">
    <h2>Left Tool (Currency Prefix)</h2>
    <TextEntry Placeholder="Amount"
               @bind-Text="amount"
               LeftTools="amountLeftTools"
               RightTools="amountRightTools" />
</div>

<div class="demo-section">
    <h2>Stepper Tool</h2>
    <TextEntry Placeholder="Quantity"
               @bind-Text="quantity"
               LeftTools="stepperLeftTools"
               RightTools="stepperRightTools" />
    <div class="state">Quantity: <code>@quantity</code></div>
</div>

<div class="demo-section">
    <h2>Stepper Tool (Step 5)</h2>
    <TextEntry Placeholder="Score"
               @bind-Text="score"
               LeftTools="scoreLeftTools"
               RightTools="scoreRightTools" />
    <div class="state">Score: <code>@score</code></div>
</div>

@code {
    string firstName = "";
    string lastName = "";
    string searchText = "";
    string password = "";
    string bio = "";
    string customText = "";
    string phone = "";
    string amount = "";
    string quantity = "0";
    string score = "50";

    string email = "";
    bool hasEmailError;
    string? emailError;

    string floatingEmail = "";
    string floatingPassword = "";
    string floatingSearch = "";
    string serial = "";
    string addonAmount = "";

    List<TextEntryTool> floatingLeftTools = [new TextEntryTool { Icon = "🔍" }];
    List<TextEntryTool> floatingRightTools = [new ClearButtonTool()];
    List<TextEntryTool> addonLeftTools = [new TextEntryTool { Text = "$" }];
    List<TextEntryTool> addonRightTools = [new TextEntryTool { Text = ".00" }];
    List<TextEntryTool> searchTools = [new ClearButtonTool()];
    List<TextEntryTool> passwordTools = [new ClearButtonTool()];
    List<TextEntryTool> emailTools = [new ClearButtonTool()];
    List<TextEntryTool> customTools = [new ClearButtonTool()];
    List<TextEntryTool> amountLeftTools = [new TextEntryTool { Text = "$", ToolColor = "#059669" }];
    List<TextEntryTool> amountRightTools = [new ClearButtonTool()];
    List<TextEntryTool> stepperLeftTools = [new TextEntryStepperTool { Step = -1 }];
    List<TextEntryTool> stepperRightTools = [new TextEntryStepperTool { Step = 1 }];
    List<TextEntryTool> scoreLeftTools = [new TextEntryStepperTool { Step = -5 }];
    List<TextEntryTool> scoreRightTools = [new TextEntryStepperTool { Step = 5 }];

    void ValidateEmail()
    {
        if (string.IsNullOrEmpty(email))
        {
            hasEmailError = false;
            emailError = null;
        }
        else if (!email.Contains('@'))
        {
            hasEmailError = true;
            emailError = "Please enter a valid email address";
        }
        else
        {
            hasEmailError = false;
            emailError = null;
        }
    }
}
