@page "/videotext"
@using Shiny.Blazor.Controls.Media
@using Shiny.Controls.Media

<PageTitle>Video Text</PageTitle>

<h1>Video Text</h1>

<div class="demo-section">
    <p>
        A looping video that plays at full strength inside the letters, under an overlay everywhere else —
        behind the same API as the MAUI <code>VideoText</code>. There is no transport bar, and sound is off
        unless you turn it on.
    </p>

    <VideoText Source="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4"
               Text="@text"
               FontSize="@fontSize"
               FontFamily="@fontFamily"
               FontStyle="@(italic ? "italic" : null)"
               OverlayColor="@overlayColor"
               OverlayOpacity="@overlayOpacity"
               Marquee="@marquee"
               IsMuted="@muted"
               Style="max-width:720px;height:220px;border-radius:12px;" />
</div>

<div class="demo-section">
    <h3>Marquee over a see-through overlay</h3>
    <VideoText Source="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4"
               Text="SHINY CONTROLS"
               OverlayColor="#0f172a"
               OverlayOpacity="0.7"
               Marquee="MarqueeDirection.Left"
               MarqueeDuration="TimeSpan.FromSeconds(6)"
               Style="max-width:720px;height:120px;border-radius:12px;" />
</div>

<div class="demo-section">
    <h3>No overlay: transparent around the letters</h3>
    <div style="max-width:720px;border-radius:12px;background:linear-gradient(135deg,#0f172a,#1e1b4b);">
        <VideoText Source="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4"
                   Text="@("IN\nBLOOM")"
                   FontSize="72"
                   OverlayColor="@null"
                   Style="height:200px;" />
    </div>
</div>

<div class="demo-section">
    <h3>Options</h3>
    <p><label>Text <input @bind="text" @bind:event="oninput" /></label></p>
    <p>
        <label>
            Font size: @(fontSize == 0 ? "auto-fit" : $"{fontSize:0}px")
            <input type="range" min="0" max="160" @bind="fontSize" @bind:event="oninput" />
        </label>
    </p>
    <p>
        <label>
            Font
            <select @bind="fontFamily">
                <option value="sans-serif">sans-serif</option>
                <option value="Georgia, serif">Georgia</option>
                <option value="'Courier New', monospace">Courier New</option>
                <option value="Impact, sans-serif">Impact</option>
            </select>
        </label>
    </p>
    <p>
        <label>
            Overlay colour
            <select @bind="overlayColor">
                <option value="black">Black</option>
                <option value="white">White</option>
                <option value="#312e81">Indigo</option>
                <option value="none">None (transparent)</option>
            </select>
        </label>
    </p>
    <p>
        <label>
            Overlay opacity: @overlayOpacity.ToString("0.00")
            <input type="range" min="0" max="1" step="0.05" @bind="overlayOpacity" @bind:event="oninput" />
        </label>
    </p>
    <p>
        <label>
            Marquee
            <select @bind="marquee">
                @foreach (var direction in Enum.GetValues<MarqueeDirection>())
                {
                    <option value="@direction">@direction</option>
                }
            </select>
        </label>
    </p>
    <p><label><input type="checkbox" @bind="muted" /> Muted</label></p>
    <p><label><input type="checkbox" @bind="italic" /> Italic</label></p>
    <p style="font-size:13px;opacity:.7;">
        Browsers only allow sound after you have interacted with the page — until then the loop keeps
        playing silently. With an overlay the text can use web fonts; with no overlay the mask can only use
        fonts installed on your system.
    </p>
</div>

@code {
    string text = "BLOOM";
    double fontSize;
    string fontFamily = "sans-serif";
    string overlayColor = "black";
    double overlayOpacity = 1;
    MarqueeDirection marquee;
    bool muted = true;
    bool italic;
}
