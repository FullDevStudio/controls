@page "/document-editor"
@using Shiny.Blazor.Controls.Office
@using Shiny.Controls.Office.Document
@using Shiny.Controls.Office.Shell
@using Shiny.Controls.Office.Skia
@implements IDisposable

<PageTitle>Document Editor</PageTitle>

<h1>Document Editor</h1>
<p class="lead">
    A <code>.docx</code> editor dressed as Word. <code>DocumentEditorView</code> wraps the bare
    <code>DocumentEditor</code> surface in the Office shell: the title bar (AutoSave, Save / Undo / Redo,
    the document name, the command search), Word's ribbon with Comments / Editing / Share at its right
    end, the ruler, the navigation and comments panes, the status bar (page, words, view modes, zoom) and
    the File backstage — New from a template, Save As, Export to PDF, Print.
</p>
<p class="lead">
    Try the command search ("table", "bold", "pdf"), drag the ruler's indent markers, pick a template
    under <strong>File › New</strong>, or <strong>File › Export › PDF</strong> — the PDF is drawn by the
    same painter as the page.
</p>

<div class="toolbar">
    <label class="chk"><input type="checkbox" @bind="withShell" /> Office shell</label>
    <label class="chk"><input type="checkbox" @bind="withToolbar" /> Editor wrapper</label>
    <label class="chk"><input type="checkbox" @bind="withFiles" /> File commands</label>
    <button class="btn" @onclick="ToggleTheme">@(dark ? "Follow page" : "Force dark")</button>
    <span class="status">@Status</span>
</div>

<div class="editor-host @(withShell && withToolbar ? "is-shell" : null)">
    @if (withToolbar)
    {
        <DocumentEditorView Document="document"
                            ShowShell="withShell"
                            ShowFileCommands="withFiles"
                            Theme="@(dark ? DocumentTheme.Dark : null)"
                            SpellChecker="checker"
                            @bind-DocumentName="name"
                            @bind-AutoSave="autoSave"
                            UserName="Allan Ritchie"
                            DocumentOpened="OnDocumentOpened"
                            ShareRequested="OnShare"
                            StatisticsChanged="s => this.statistics = s"
                            DocumentChanged="OnChanged" />
    }
    else
    {
        <DocumentEditor Document="document"
                        Theme="@(dark ? DocumentTheme.Dark : null)"
                        SpellChecker="checker"
                        DocumentChanged="OnChanged" />
    }
</div>

<p class="hint">
    Click to place the caret, drag to select, double-click a word, triple-click a paragraph. Word's
    shortcuts work: Ctrl/Cmd+B, I, U, C, X, V, Z, Y, F (navigation pane search), H (replace), K (link),
    E/L/R/J (alignment), Ctrl+Enter (page break) and Ctrl+Alt+1..3 (headings). Tab walks table cells;
    Ctrl+click follows a link. Right-click a red-underlined word for corrections. File ▸ Open, Save,
    Save As, Export and the recent list come from the document store <code>Program.cs</code> registers
    (<code>AddShinyOfficeDocumentStore()</code>) — this page wires none of them. In Chrome and Edge
    they are real files on disk; elsewhere Open is an upload and Save is a download.
</p>

@code {
    WordDocument? document;

    /// <summary>
    /// The web has no platform spell checker, so the sample supplies one.
    /// </summary>
    /// <remarks>
    /// On MAUI this parameter would be left off entirely — the package registers the iOS, Android,
    /// macOS and Windows checkers itself. Setting it is how any host overrides that.
    /// </remarks>
    readonly SampleSpellChecker checker = new();

    bool withShell = true;
    bool withToolbar = true;

    // Off is an app that owns its files: no File button or backstage, no Save in the title bar. It
    // would call view.SaveAsync() / OpenAsync(stream, name) from its own UI instead.
    bool withFiles = true;
    bool dark;
    bool autoSave;
    string? name = "Quarterly Report";
    string? message;
    DocumentStatistics? statistics;
    int edits;

    string Status => this.document is null
        ? "loading"
        : this.message ?? $"{(this.statistics is { } s ? $"{s.Words} words · " : string.Empty)}{this.edits} edits";

    protected override async Task OnInitializedAsync()
    {
        var bytes = SampleOfficeDocuments.BuildDocument();
        this.document = await WordDocument.OpenAsync(new MemoryStream(bytes), editable: true);
    }

    void ToggleTheme() => this.dark = !this.dark;

    void OnShare() => this.message = "Share is the host's: copy a link, open a dialog...";

    void OnDocumentOpened(WordDocument opened)
        => this.message = "Opened a document from the backstage";

    void OnChanged()
    {
        this.edits++;
        this.message = null;
        this.StateHasChanged();
    }

    public void Dispose() => this.document?.Dispose();
}
