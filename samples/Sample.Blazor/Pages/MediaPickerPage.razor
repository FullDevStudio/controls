@page "/mediapicker"

<PageTitle>Media Picker</PageTitle>

<h1>Media Picker</h1>
<p style="color:#888;max-width:640px;">
    Add photos from the gallery (or camera on mobile browsers), compressed to your chosen
    format/quality, shown inline as a carousel with tap-to-view and optional editing.
</p>

<div class="demo-controls" style="display:flex;gap:16px;align-items:center;margin:12px 0;flex-wrap:wrap;">
    <label><input type="checkbox" @bind="allowGallery" /> Allow gallery</label>
    <label><input type="checkbox" @bind="allowCamera" /> Allow camera</label>
    <label><input type="checkbox" @bind="allowEdit" /> Allow edit</label>
    <label><input type="checkbox" @bind="showCarousel" /> Carousel in view</label>
    <label><input type="checkbox" @bind="usePng" /> PNG output</label>
    <label>Max: <input type="number" min="1" max="10" @bind="maxPhotos" style="width:56px;" /></label>
    <label>Quality: <input type="range" min="10" max="100" @bind="quality" style="width:120px;vertical-align:middle;" /> @quality%</label>
    <label>Spacing: <input type="range" min="0" max="32" @bind="spacing" @bind:event="oninput" style="width:120px;vertical-align:middle;" /> @(spacing)px</label>
</div>

<div style="max-width:640px;">
    <MediaPickerButton @bind-Photos="photos"
                       AllowGallery="allowGallery"
                       AllowCamera="allowCamera"
                       AllowPhotoEdit="allowEdit"
                       ShowAsCarouselInView="showCarousel"
                       MaxPhotos="maxPhotos"
                       CompressionQuality="quality"
                       OutputFormat="@(usePng ? "png" : "jpeg")"
                       ItemSpacing="spacing"
                       PermissionDeniedText="Photo access was denied." />
</div>

<div style="display:flex;gap:8px;margin-top:12px;">
    <button @onclick="LoadSaved">Load saved photos</button>
    <button @onclick="() => photos = []">Clear</button>
</div>
<p style="color:#888;max-width:640px;">
    "Load saved photos" hands the picker two photos the server already has. The first is locked
    (<code>CanRemove = false</code>), so it has no &#10005;.
</p>

<p style="margin-top:12px;font-weight:600;">Photos added: @photos.Count</p>

<p style="color:#888;max-width:640px;">
    Each photo stays in the browser — .NET gets an id, a preview URL and the size, and the bytes only
    move when something asks for them. Read one below, or point <code>UploadUrl</code> at an endpoint
    and the browser posts it as multipart itself.
</p>

@if (photos.Count > 0)
{
    <button @onclick="ReadFirst">Read the first photo's bytes</button>
    <span style="margin-left:8px;">@readReport</span>
}

<h2 style="margin-top:32px;">Custom add button</h2>
<p style="color:#888;max-width:640px;">
    <code>AddButtonTemplate</code> replaces the dashed button. It is rendered inside the button that does
    the adding, so keep it to markup &mdash; no buttons or links of its own.
</p>
<div style="max-width:640px;">
    <MediaPickerButton @bind-Photos="customPhotos" MaxPhotos="3" ItemSpacing="16" AddButtonText="Add up to 3 photos">
        <AddButtonTemplate>
            <div style="display:flex;align-items:center;justify-content:center;gap:12px;padding:16px;border-radius:16px;background:var(--shiny-color-primary-container, #D8E2FF);color:var(--shiny-color-on-primary-container, #001A41);">
                <span style="font-size:24px;">&#128247;</span>
                <span style="display:flex;flex-direction:column;align-items:flex-start;">
                    <strong>Add up to 3 photos</strong>
                    <small style="opacity:0.7;">Gallery or camera</small>
                </span>
            </div>
        </AddButtonTemplate>
    </MediaPickerButton>
</div>

<h2 style="margin-top:32px;">Inside a sheet</h2>
<p style="color:#888;max-width:640px;">
    A sheet moves with a CSS transform, which would trap a <code>position:fixed</code> overlay inside it.
    The chooser, the viewer and the editor are raised to the browser's top layer, so they still cover
    the screen.
</p>
<button @onclick="() => sheetOpen = true">Open a sheet with a picker</button>

<SheetView @bind-IsOpen="sheetOpen" Detents="@([DetentValue.Half])" SheetCornerRadius="20">
    <SheetContent>
        <h3>Add a comment</h3>
        <MediaPickerButton @bind-Photos="sheetPhotos"
                           AllowPhotoEdit="true"
                           MaxPhotos="1"
                           AddButtonText="Add a photo" />
    </SheetContent>
</SheetView>

@code {
    bool sheetOpen;
    IReadOnlyList<Shiny.Blazor.Controls.MediaPickerItem> sheetPhotos = [];
    IReadOnlyList<Shiny.Blazor.Controls.MediaPickerItem> photos = [];
    IReadOnlyList<Shiny.Blazor.Controls.MediaPickerItem> customPhotos = [];
    string readReport = "";
    int spacing = 12;

    void LoadSaved() => photos =
    [
        new() { DataUri = "images/sample_photo1.jpg", ContentType = "image/jpeg", Width = 900, Height = 1200, CanRemove = false },
        new() { DataUri = "images/sample_photo2.jpg", ContentType = "image/jpeg", Width = 900, Height = 1200 }
    ];

    async Task ReadFirst()
    {
        try
        {
            var bytes = await photos[0].ReadAllBytesAsync();
            readReport = $"{bytes.Length:N0} bytes, {photos[0].ContentType}, {photos[0].Width}×{photos[0].Height}";
        }
        catch (InvalidOperationException)
        {
            // A saved photo was handed in by URL; the browser never held its bytes.
            readReport = "That one was loaded from the server, not picked here.";
        }
    }

    bool allowGallery = true;
    bool allowCamera = true;
    bool allowEdit = true;
    bool showCarousel = true;
    bool usePng;
    int maxPhotos = 5;
    int quality = 85;
}
