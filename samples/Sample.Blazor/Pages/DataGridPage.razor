@page "/datagrid"

<PageTitle>DataGrid</PageTitle>

<h1>DataGrid</h1>

<p class="status-message">@status</p>

<section class="demo-section">
    <h2>Options</h2>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;">
        <label class="toggle-row"><span>Dense</span><input type="checkbox" @bind="dense" /></label>
        <label class="toggle-row"><span>Striped</span><input type="checkbox" @bind="striped" /></label>
        <label class="toggle-row"><span>Bordered</span><input type="checkbox" @bind="bordered" /></label>
        <label class="toggle-row"><span>Hover</span><input type="checkbox" @bind="hover" /></label>
        <label>Selection
            <select @bind="selectionMode">
                @foreach (var v in Enum.GetValues<DataGridSelectionMode>())
                {
                    <option value="@v">@v</option>
                }
            </select>
        </label>
        <label class="toggle-row"><span>Loading</span><input type="checkbox" @bind="loading" /></label>
    </div>
</section>

<section class="demo-section">
    <h2>Full-featured data grid</h2>
    <p>Multi-sort (click headers), filter menus, grouping (⊞ icon), paging, and form editing (click a row).</p>
    <DataGrid TItem="Person"
              Items="people"
              SelectionMode="selectionMode"
              SelectedItemsChanged="OnSelectionChanged"
              SortMode="DataGridSortMode.Multiple"
              FilterMode="filterMode"
              Groupable="true"
              EditMode="editMode"
              Dense="dense" Striped="striped" Bordered="bordered" Hover="hover"
              Loading="loading"
              ColumnResizeMode="DataGridColumnResizeMode.Column"
              DragDropColumnReordering="true"
              CommittedItemChanges="OnSaved">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First" />
            <PropertyColumn Property="x => x.LastName" Title="Last" />
            <PropertyColumn Property="x => x.Age" Format="N0" />
            <PropertyColumn Property="x => x.Department" />
            <PropertyColumn Property="x => x.Salary" Format="C0">
                <FooterTemplate>Total: @people.Sum(p => p.Salary).ToString("C0")</FooterTemplate>
            </PropertyColumn>
            <TemplateColumn Title="Status" Sortable="false" Filterable="false">
                <CellTemplate>
                    <Pill Text="@(context.Item.Active ? "Active" : "Inactive")"
                          Type="@(context.Item.Active ? PillType.Success : PillType.Caution)" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <DataGridPager TItem="Person" />
        </PagerContent>
    </DataGrid>
</section>

<section class="demo-section">
    <h2>Frozen columns + sticky header</h2>
    <p>
        Thirteen columns, ~2,150px wide, so there is plenty to scroll through. Scroll sideways and down:
        the header stays put, the first @frozenStart column(s) stay pinned to the left and the last
        @frozenEnd to the right. Frozen cells sit above the scrolling ones, so
        content slides underneath them.
    </p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:12px;">
        <label>Frozen at start
            <select @bind="frozenStart">
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
            </select>
        </label>
        <label>Frozen at end
            <select @bind="frozenEnd">
                <option value="0">0</option>
                <option value="1">1</option>
            </select>
        </label>
        <label class="toggle-row"><span>Multi-select</span><input type="checkbox" @bind="frozenMultiSelect" /></label>
    </div>
    @* A grid the size of a pane, on purpose: the header pinning while the rows scroll under it is
       the feature, so this one keeps its own scroller - framed, with overscroll contained. *@
    <div class="demo-frame">
        <DataGrid TItem="Person"
                  Items="people"
                  SelectionMode="@(frozenMultiSelect ? DataGridSelectionMode.Multiple : DataGridSelectionMode.None)"
                  SortMode="DataGridSortMode.Single"
                  Striped="true" Bordered="true" Hover="true"
                  FixedHeader="true" Height="300px"
                  FrozenColumns="frozenStart"
                  FrozenEndColumns="frozenEnd">
            <Columns>
                <PropertyColumn Property="x => x.FirstName" Title="First" Width="160px" />
                <PropertyColumn Property="x => x.LastName" Title="Last" Width="160px" />
                <PropertyColumn Property="x => x.Age" Format="N0" Width="120px" />
                <PropertyColumn Property="x => x.Department" Width="200px" />
                <PropertyColumn Property="x => x.Salary" Format="C0" Width="180px" />
                <PropertyColumn Property="x => x.Location" Width="180px" />
                <PropertyColumn Property="x => x.CostCentre" Title="Cost centre" Width="180px" />
                <PropertyColumn Property="x => x.Manager" Width="180px" />
                <PropertyColumn Property="x => x.Email" Width="240px" />
                <PropertyColumn Property="x => x.StartDate" Title="Started" Format="d" Width="140px" />
                <PropertyColumn Property="x => x.Region" Width="160px" />
                <PropertyColumn Property="x => x.Extension" Title="Ext." Width="110px" />
                <TemplateColumn Title="Status" Sortable="false" Filterable="false" Width="140px">
                    <CellTemplate>
                        <Pill Text="@(context.Item.Active ? "Active" : "Inactive")"
                              Type="@(context.Item.Active ? PillType.Success : PillType.Caution)" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </DataGrid>
    </div>
</section>

<section class="demo-section">
    <h2>Column resizing (min / max width)</h2>
    <p>
        Drag the right edge of a header. <code>Column</code> mode lets the grid grow; <code>Container</code>
        mode takes the difference out of the next resizable column so the total stays put. Each column
        declares its own bounds: <strong>First</strong> 80–260px, <strong>Salary</strong> 120–200px,
        <strong>Department</strong> falls back to the grid-level 60–420px, and <strong>Status</strong> sets
        <code>Resizable="false"</code> so it offers no handle at all.
    </p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:12px;">
        <label>Resize mode
            <select @bind="resizeMode">
                @foreach (var v in Enum.GetValues<DataGridColumnResizeMode>())
                {
                    <option value="@v">@v</option>
                }
            </select>
        </label>
        <button class="btn btn-primary" @onclick="() => resizeGrid?.ResetColumnWidths()">Reset widths</button>
        <span class="status-message">@resizeStatus</span>
    </div>
    <DataGrid TItem="Person" @ref="resizeGrid"
              Items="people"
              ColumnResizeMode="resizeMode"
              MinColumnWidth="60"
              MaxColumnWidth="420"
              ColumnResized="OnColumnResized"
              SortMode="DataGridSortMode.Single"
              Striped="true" Bordered="true" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First" Width="160px" MinWidth="80px" MaxWidth="260px" />
            <PropertyColumn Property="x => x.LastName" Title="Last" Width="160px" />
            <PropertyColumn Property="x => x.Department" />
            <PropertyColumn Property="x => x.Salary" Format="C0" Width="160px" MinWidth="120px" MaxWidth="200px" />
            <TemplateColumn Title="Status" Sortable="false" Filterable="false" Resizable="false" Width="140px">
                <CellTemplate>
                    <Pill Text="@(context.Item.Active ? "Active" : "Inactive")"
                          Type="@(context.Item.Active ? PillType.Success : PillType.Caution)" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</section>

<section class="demo-section">
    <h2>Percentage widths &amp; drag-drop column order</h2>
    <p>
        Widths are percentages, so the columns keep their proportions as the window changes.
        Reordering is <strong>off by default</strong> — the toggle below is the grid's
        <code>DragDropColumnReordering</code>. With it on, drag a header onto another: a marker shows the
        edge it will land on, and dropping to the <em>right</em> of a column puts it after that column.
    </p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:12px;">
        <label class="toggle-row"><span>Drag-drop reordering</span>
            <input type="checkbox" @bind="reordering" /></label>
        <button class="btn btn-primary" @onclick="() => orderGrid?.ResetColumnOrder()">Reset order</button>
        <span class="status-message">@orderStatus</span>
    </div>
    <DataGrid TItem="Person" @ref="orderGrid"
              Items="people"
              DragDropColumnReordering="reordering"
              ColumnReordered="OnColumnReordered"
              SortMode="DataGridSortMode.Single"
              Striped="true" Bordered="true" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First" Width="20%" MinWidth="90px" />
            <PropertyColumn Property="x => x.LastName" Title="Last" Width="20%" MinWidth="90px" />
            <PropertyColumn Property="x => x.Department" Width="30%" />
            <PropertyColumn Property="x => x.Salary" Format="C0" Width="30%" />
        </Columns>
    </DataGrid>
</section>

<section class="demo-section">
    <h2>Column formatting</h2>
    <p>
        Everything below is a plain <code>PropertyColumn</code> &mdash; no <code>CellTemplate</code> anywhere.
        <code>DisplayAs</code> picks a preset (<code>Currency</code>, <code>Percent</code>, <code>Date</code>,
        <code>FileSize</code>, <code>Boolean</code>, <code>Enum</code>), <code>Decimals</code> tunes it,
        <code>NullText</code> covers the gaps, <code>Prefix</code>/<code>Suffix</code> decorate the value,
        and <code>CellStyle</code> colours the cell from the row. Numeric columns right-align on their own,
        and the header follows them.
    </p>
    <DataGrid TItem="Person"
              Items="people"
              SortMode="DataGridSortMode.Single"
              Striped="true" Bordered="true" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First" Width="120px" />

            @* Auto alignment sends this right; Decimals trims the trailing ".00". *@
            <PropertyColumn Property="x => x.Salary" DisplayAs="DataGridColumnFormat.Currency" Decimals="0" Width="120px" />

            @* .NET's "P" multiplies by 100, so 0.61 renders as 61%. *@
            <PropertyColumn Property="x => x.Utilisation" Title="Util." DisplayAs="DataGridColumnFormat.Percent" Decimals="0" Width="90px" />

            <PropertyColumn Property="x => x.MailboxBytes" Title="Mailbox" DisplayAs="DataGridColumnFormat.FileSize" Width="110px" />

            @* Inactive people have no review date - NullText is what stops the cell going blank. *@
            <PropertyColumn Property="x => x.LastReview" Title="Reviewed"
                            DisplayAs="DataGridColumnFormat.Date" NullText="—" Width="120px" />

            @* Description attribute wins; without one the member name is split on PascalCase. *@
            <PropertyColumn Property="x => x.State" Title="State" DisplayAs="DataGridColumnFormat.Enum" Width="140px" />

            <PropertyColumn Property="x => x.Active" Title="On" DisplayAs="DataGridColumnFormat.Boolean"
                            Alignment="DataGridCellAlignment.Center" Width="60px" />

            <PropertyColumn Property="x => x.YearsOfService" Title="Tenure" Suffix=" yrs" Width="90px" />

            @* TextFormatter is the escape hatch that still is not a template. *@
            <PropertyColumn Property="x => x.Age" Title="Band" Width="90px"
                            TextFormatter="@(a => a < 40 ? "Junior" : a < 50 ? "Senior" : "Principal")" />
        </Columns>
    </DataGrid>
</section>

<section class="demo-section">
    <h2>Grouping &amp; summary rows</h2>
    <p>
        <code>GroupBy</code> is a list of columns, outermost first &mdash; bind it and the grid re-groups
        itself. <code>Groupable</code> adds the &#9746; button to every header, and each tap appends a
        level. One set of <code>SummaryRows</code> serves the grid's footer <em>and</em> every group:
        a cell either aggregates its column or simply fills the slot with a label, which is what puts
        &ldquo;Total&rdquo; in one column and the number in the next. <code>GroupSummaryPlacement</code>
        decides whether a group's totals sit under its rows (and collapse with them) or under its title,
        where they stay visible while it is collapsed.
    </p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:12px;">
        <button class="btn btn-primary" @onclick="@(() => groupBy = [nameof(Person.Department)])">Department</button>
        <button class="btn btn-primary" @onclick="@(() => groupBy = [nameof(Person.Department), nameof(Person.Region)])">Dept + Region</button>
        <button class="btn btn-primary" @onclick="@(() => groupBy = [])">Ungroup</button>
        <label>Group summaries
            <select @bind="groupSummaryPlacement">
                @foreach (var v in Enum.GetValues<DataGridGroupSummaryPlacement>())
                {
                    <option value="@v">@v</option>
                }
            </select>
        </label>
    </div>
    <DataGrid TItem="Person"
              Items="people"
              @bind-GroupBy="groupBy"
              Groupable="true"
              GroupSummaryPlacement="groupSummaryPlacement"
              SortMode="DataGridSortMode.Single"
              Striped="true" Bordered="true" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.Department" Width="150px" />
            <PropertyColumn Property="x => x.Region" Width="120px" />
            <PropertyColumn Property="x => x.LastName" Title="Name" Width="140px" />
            @* No format on the summary cell below: an aggregate wears its own column's dress, so the
               total under a currency column is currency too. *@
            <PropertyColumn Property="x => x.Salary" DisplayAs="DataGridColumnFormat.Currency" Decimals="0" Width="130px" />
            <PropertyColumn Property="x => x.Age" Width="80px" />
        </Columns>
        <SummaryRows>
            <SummaryRow>
                <SummaryCell Column="@nameof(Person.LastName)" Text="Total" Alignment="DataGridCellAlignment.End" />
                <SummaryCell Column="@nameof(Person.Salary)" Aggregate="DataGridAggregateType.Sum" />
                <SummaryCell Column="@nameof(Person.Age)" Aggregate="DataGridAggregateType.Count" />
            </SummaryRow>
            <SummaryRow>
                <SummaryCell Column="@nameof(Person.LastName)" Text="Average" Alignment="DataGridCellAlignment.End" Bold="false" />
                <SummaryCell Column="@nameof(Person.Salary)" Aggregate="DataGridAggregateType.Average" Bold="false" />
                <SummaryCell Column="@nameof(Person.Age)" Aggregate="DataGridAggregateType.Average" StringFormat="N1" Bold="false" />
            </SummaryRow>
        </SummaryRows>
    </DataGrid>
</section>

<section class="demo-section">
    <h2>Conditional cell styling &amp; wrapping</h2>
    <p>
        <code>CellStyle</code> takes the row and returns colours/weight for that one cell, so "highlight
        the underpaid" and "flag a missing review" stop being reasons to write a template.
        <code>Wrap</code> plus <code>MaxLines</code> lets one column breathe while the rest stay on a line.
    </p>
    <DataGrid TItem="Person" Items="people" SortMode="DataGridSortMode.Single" Striped="true" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First" Width="110px" />
            <PropertyColumn Property="x => x.Salary" DisplayAs="DataGridColumnFormat.Currency" Decimals="0" Width="130px"
                            CellStyle="@(p => p.Salary < 150000
                                ? new DataGridCellStyle { TextColor = "var(--shiny-color-error, #c62828)", Bold = true }
                                : null)" />
            <PropertyColumn Property="x => x.LastReview" Title="Reviewed" DisplayAs="DataGridColumnFormat.Date"
                            NullText="Overdue" Width="130px"
                            CellStyle="@(p => p.LastReview is null
                                ? new DataGridCellStyle { BackgroundColor = "rgba(245, 158, 11, .18)", Bold = true }
                                : null)" />
            <PropertyColumn Property="x => x.Notes" Title="Notes" Wrap="true" MaxLines="2" />
        </Columns>
    </DataGrid>
</section>

<section class="demo-section">
    <h2>Highlighting rows, columns &amp; cells</h2>
    <p>
        A <code>DataGridHighlight</code> covers whatever it names: a row (<code>RowPredicate</code> or
        <code>Item</code>), a column (<code>Column</code>), the one cell where they cross, or &mdash;
        naming neither &mdash; the whole grid. <code>Fill</code> is a wash laid <em>behind</em> the text
        at <code>FillOpacity</code> (0.25 by default), so the row's stripe and selection keep showing
        through and nothing is ever obscured by its own highlight. <code>BorderColor</code> plus
        <code>BorderStyle</code> traces the <strong>perimeter of the region</strong> &mdash; a highlighted
        row is outlined as a row, not as a run of boxed cells.
    </p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:12px;">
        <label><input type="checkbox" @bind="highlightColumn" /> Highlight the Salary column</label>
        <label><input type="checkbox" @bind="highlightRows" /> Highlight inactive rows</label>
        <label><input type="checkbox" @bind="highlightCell" /> Ring one cell</label>
        <label>Border
            <select @bind="highlightBorder">
                @foreach (var v in Enum.GetValues<DataGridBorderStyle>())
                {
                    <option value="@v">@v</option>
                }
            </select>
        </label>
        <label>Fill opacity
            <input type="range" min="0" max="1" step="0.05" @bind="highlightOpacity" @bind:event="oninput" />
            @highlightOpacity.ToString("0.00")
        </label>
    </div>
    <DataGrid TItem="Person" Items="people" SortMode="DataGridSortMode.Single"
              Striped="true" Hover="true" Highlights="Highlights">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First" Width="110px" />
            <PropertyColumn Property="x => x.Department" Width="140px" />
            <PropertyColumn Property="x => x.Salary" DisplayAs="DataGridColumnFormat.Currency" Decimals="0" Width="130px" />
            <PropertyColumn Property="x => x.Active" Title="On" DisplayAs="DataGridColumnFormat.Boolean"
                            Alignment="DataGridCellAlignment.Center" Width="70px" />
        </Columns>
    </DataGrid>
</section>

<section class="demo-section">
    <h2>Detail (breakdown) rows</h2>
    <p>
        A <code>RowDetailTemplate</code> adds a caret column at the leading edge; expanding a row opens a
        full-width row underneath it that can host anything. <code>ExpandMode</code> decides whether one
        row or many stay open. This one also has a <code>RowDetailLoader</code>: the caret becomes a
        spinner while it runs, the detail row shows <code>RowDetailLoadingTemplate</code>, and the grid's
        <code>IsBusy</code> is <strong>@busy</strong>.
    </p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:12px;">
        <label>Expand mode
            <select @bind="expandMode">
                @foreach (var v in Enum.GetValues<DataGridExpandMode>())
                {
                    <option value="@v">@v</option>
                }
            </select>
        </label>
    </div>
    <DataGrid TItem="Person"
              Items="people"
              ExpandMode="expandMode"
              SortMode="DataGridSortMode.Single"
              Striped="true" Hover="true"
              RowDetailLoader="LoadActivityAsync"
              IsBusyChanged="b => busy = b"
              RowExpanded="OnRowExpanded">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First" />
            <PropertyColumn Property="x => x.LastName" Title="Last" />
            <PropertyColumn Property="x => x.Department" />
            <PropertyColumn Property="x => x.Salary" Format="C0" />
        </Columns>
        <RowDetailTemplate>
            @* Only rendered once RowDetailLoader has finished, so activity is always there. *@
            <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-start;">
                <strong>Breakdown for @context.FirstName @context.LastName</strong>
                <div>Location: @context.Location</div>
                <div>Cost centre: @context.CostCentre</div>
                <div>Recent activity: @activity[context.CostCentre]</div>
                <Pill Text="@(context.Active ? "Active" : "Inactive")"
                      Type="@(context.Active ? PillType.Success : PillType.Caution)" />
            </div>
        </RowDetailTemplate>
        <RowDetailLoadingTemplate>
            <div style="display:flex;gap:8px;align-items:center;">
                <span class="shiny-dg-busy"></span>
                <span>Fetching @context.FirstName's activity…</span>
            </div>
        </RowDetailLoadingTemplate>
    </DataGrid>
</section>

<section class="demo-section">
    <h2>Tree grid</h2>
    <p>
        <code>TreeDataGrid</code> is the same grid with a <code>ChildrenSelector</code>: rows nest and the
        first column carries the indent and caret. "Field operations" uses <code>ChildrenLoader</code>, so
        its children are fetched the first time it opens. Filtering keeps a parent whose descendant matches.
    </p>
    <TreeDataGrid TItem="CostNode"
                  Items="accounts"
                  ChildrenSelector="n => n.Lazy ? null : n.Children"
                  ChildrenLoader="LoadRegionsAsync"
                  HasChildrenSelector="n => n.Lazy || n.Children.Count > 0"
                  TreeIndentSize="18"
                  FilterMode="DataGridFilterMode.Toolbar"
                  SortMode="DataGridSortMode.Single"
                  Striped="true" Bordered="true" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Account" />
            <PropertyColumn Property="x => x.Kind" />
            <PropertyColumn Property="x => x.Budget" Format="C0" />
        </Columns>
    </TreeDataGrid>
</section>

@code {
    // ---- highlighting demo ----
    bool highlightColumn = true;
    bool highlightRows = true;
    bool highlightCell;
    DataGridBorderStyle highlightBorder = DataGridBorderStyle.Dashed;
    double highlightOpacity = 0.25;

    // Rebuilt per render rather than held in a field: the rules are derived from the toggles above, and
    // a fresh list is cheaper to reason about than keeping one in sync with five bound controls.
    IEnumerable<DataGridHighlight<Person>> Highlights
    {
        get
        {
            if (highlightColumn)
            {
                yield return new DataGridHighlight<Person>
                {
                    Column = nameof(Person.Salary),
                    Fill = "var(--shiny-color-primary, #7c3aed)",
                    FillOpacity = highlightOpacity
                };
            }

            if (highlightRows)
            {
                yield return new DataGridHighlight<Person>
                {
                    RowPredicate = p => !p.Active,
                    Fill = "var(--shiny-color-error, #c62828)",
                    FillOpacity = highlightOpacity,
                    BorderColor = "var(--shiny-color-error, #c62828)",
                    BorderStyle = highlightBorder
                };
            }

            if (highlightCell)
            {
                // Naming a row and a column together lands on exactly one cell, which is then boxed on
                // all four sides rather than getting the row's or column's open-ended perimeter.
                yield return new DataGridHighlight<Person>
                {
                    Item = people.FirstOrDefault(),
                    Column = nameof(Person.Department),
                    BorderColor = "var(--shiny-color-tertiary, #0f766e)",
                    BorderStyle = DataGridBorderStyle.Solid,
                    BorderWidth = "3px"
                };
            }
        }
    }

    string status = "Pick options and interact with the grid";
    DataGridExpandMode expandMode = DataGridExpandMode.Multiple;
    int frozenStart = 1, frozenEnd = 1;
    bool frozenMultiSelect;
    bool dense, striped = true, bordered, hover = true, loading;
    DataGridSelectionMode selectionMode = DataGridSelectionMode.Multiple;
    DataGridFilterMode filterMode = DataGridFilterMode.Menu;
    DataGridEditMode editMode = DataGridEditMode.Form;

    DataGrid<Person>? resizeGrid;
    DataGridColumnResizeMode resizeMode = DataGridColumnResizeMode.Column;
    string resizeStatus = "Drag a header edge";

    void OnColumnResized(ColumnResizedEventArgs e)
        => resizeStatus = $"{e.ColumnId} → {e.Width:0}px";

    DataGrid<Person>? orderGrid;
    bool reordering = true;
    string orderStatus = "Drag a header onto another";

    void OnColumnReordered(ColumnReorderedEventArgs e)
        => orderStatus = $"Moved {e.ColumnId} — now {string.Join(", ", e.Order)}";

    void OnRowExpanded(Person p) => status = $"Opened {p.FirstName}";

    bool busy;
    readonly Dictionary<string, string> activity = new();

    // Stands in for an API call - the detail template is not rendered until this completes.
    async Task LoadActivityAsync(Person p)
    {
        await Task.Delay(900);
        activity[p.CostCentre] = $"{p.LastName.Length + 3} approvals this quarter";
    }

    // ---- grouping demo ----
    IReadOnlyList<string> groupBy = [nameof(Person.Department)];
    DataGridGroupSummaryPlacement groupSummaryPlacement = DataGridGroupSummaryPlacement.Footer;

    List<Person> people = Person.Sample();
    List<CostNode> accounts = CostNode.Sample();

    // Stands in for a network call so the loading caret is actually visible.
    async Task<IEnumerable<CostNode>> LoadRegionsAsync(CostNode node)
    {
        await Task.Delay(600);
        status = $"Loaded {node.Name}";
        // ChildrenLoader is a plain Func, not an EventCallback, so nothing re-renders this page for us.
        StateHasChanged();
        return new List<CostNode>
        {
            new() { Name = "Northern region", Kind = "Team", Budget = 128_000 },
            new() { Name = "Southern region", Kind = "Team", Budget = 112_000 }
        };
    }

    public class CostNode
    {
        public string Name { get; set; } = "";
        public string Kind { get; set; } = "";
        public decimal Budget { get; set; }
        public bool Lazy { get; set; }
        public List<CostNode> Children { get; } = new();

        public static List<CostNode> Sample()
        {
            var engineering = new CostNode { Name = "Engineering", Kind = "Division", Budget = 612_000 };
            var platform = new CostNode { Name = "Platform", Kind = "Team", Budget = 318_000 };
            platform.Children.Add(new() { Name = "Runtime", Kind = "Squad", Budget = 174_000 });
            platform.Children.Add(new() { Name = "Tooling", Kind = "Squad", Budget = 144_000 });
            var mobile = new CostNode { Name = "Mobile", Kind = "Team", Budget = 294_000 };
            mobile.Children.Add(new() { Name = "iOS", Kind = "Squad", Budget = 151_000 });
            mobile.Children.Add(new() { Name = "Android", Kind = "Squad", Budget = 143_000 });
            engineering.Children.Add(platform);
            engineering.Children.Add(mobile);

            var research = new CostNode { Name = "Research", Kind = "Division", Budget = 388_000 };
            research.Children.Add(new() { Name = "Applied", Kind = "Team", Budget = 205_000 });
            research.Children.Add(new() { Name = "Long range", Kind = "Team", Budget = 183_000 });

            return new List<CostNode>
            {
                engineering,
                research,
                new() { Name = "Field operations", Kind = "Division", Budget = 240_000, Lazy = true }
            };
        }
    }

    void OnSelectionChanged(IReadOnlyCollection<Person> selected)
        => status = $"{selected.Count} selected";

    void OnSaved(Person p) => status = $"Saved {p.FirstName} {p.LastName}";

    public enum ReviewState
    {
        [System.ComponentModel.Description("Signed off")]
        SignedOff,

        AwaitingReview
    }

    public class Person
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public int Age { get; set; }
        public string Department { get; set; } = "";
        public decimal Salary { get; set; }
        public bool Active { get; set; }
        public string Location { get; set; } = "";
        public string CostCentre { get; set; } = "";
        public string Manager { get; set; } = "";
        public string Email { get; set; } = "";
        public DateTime StartDate { get; set; }
        public string Region { get; set; } = "";
        public string Extension { get; set; } = "";

        // Derived rather than seeded, so the formatting demo below exercises every preset (including a
        // genuine null) without another eight lines of literals per row.
        public double Utilisation => (this.Age % 30 + 55) / 100d;
        public long MailboxBytes => (long)this.Salary * 6_400;
        public DateTime? LastReview => this.Active ? this.StartDate.AddYears(this.Age % 4 + 1) : null;
        public ReviewState State => this.Active ? ReviewState.SignedOff : ReviewState.AwaitingReview;
        public int YearsOfService => DateTime.Today.Year - this.StartDate.Year;
        public string Notes
            => $"{this.FirstName} reports to {this.Manager} out of {this.Location}, on cost centre {this.CostCentre} in the {this.Region} region.";

